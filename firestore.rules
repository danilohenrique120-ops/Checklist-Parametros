rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'DaniloHenrique120@gmail.com'
      );
    }

    // 3. Entity Blueprint Validation Helper: ChecklistRecord
    function isValidChecklist(data) {
      return data.keys().hasAll([
        'id',
        'plantId',
        'authorUid',
        'reactorId',
        'reactorTag',
        'scale',
        'batchId',
        'operatorName',
        'date',
        'time',
        'timestamp',
        'processHours',
        'archived',
        'temperature',
        'dissolvedOxygen',
        'agitation',
        'pressure',
        'airflow',
        'isTemperatureNominal',
        'isPressureNominal',
        'isAgitationNominal',
        'isAirflowNominal',
        'isDONominal',
        'isFullyNominal',
        'deviationsCount',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'plantId',
        'authorUid',
        'reactorId',
        'reactorTag',
        'scale',
        'batchId',
        'operatorName',
        'date',
        'time',
        'timestamp',
        'processHours',
        'archived',
        'temperature',
        'dissolvedOxygen',
        'standardCurveO2',
        'agitation',
        'pressure',
        'airflow',
        'isTemperatureNominal',
        'isPressureNominal',
        'isAgitationNominal',
        'isAirflowNominal',
        'isDONominal',
        'isFullyNominal',
        'deviationsCount',
        'deviationNotes',
        'operatorSignature',
        'notes',
        'createdAt',
        'updatedAt'
      ]) &&
      data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.plantId is string && data.plantId.size() >= 1 && data.plantId.size() <= 32 && data.plantId.matches('^biotrack-main$') &&
      data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 && data.authorUid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.reactorId is number && data.reactorId >= 1 && data.reactorId <= 16 &&
      data.reactorTag is string && data.reactorTag.size() >= 2 && data.reactorTag.size() <= 16 &&
      data.scale is string && data.scale.size() <= 10 && data.scale in ['100L', '500L', '3000L', '5000L'] &&
      data.batchId is string && data.batchId.size() >= 1 && data.batchId.size() <= 64 &&
      data.operatorName is string && data.operatorName.size() >= 1 && data.operatorName.size() <= 100 &&
      data.date is string && data.date.size() >= 8 && data.date.size() <= 16 &&
      data.time is string && data.time.size() >= 4 && data.time.size() <= 10 &&
      data.timestamp is number && data.timestamp >= 0 &&
      data.processHours is number && data.processHours >= 0 && data.processHours <= 10000 &&
      data.archived is bool &&
      data.temperature is number && data.temperature >= -50 && data.temperature <= 200 &&
      data.dissolvedOxygen is number && data.dissolvedOxygen >= 0 && data.dissolvedOxygen <= 500 &&
      (!('standardCurveO2' in data) || (data.standardCurveO2 is number && data.standardCurveO2 >= 0 && data.standardCurveO2 <= 500)) &&
      data.agitation is number && data.agitation >= 0 && data.agitation <= 5000 &&
      data.pressure is number && data.pressure >= -10 && data.pressure <= 100 &&
      data.airflow is number && data.airflow >= 0 && data.airflow <= 50000 &&
      data.isTemperatureNominal is bool &&
      data.isPressureNominal is bool &&
      data.isAgitationNominal is bool &&
      data.isAirflowNominal is bool &&
      data.isDONominal is bool &&
      data.isFullyNominal is bool &&
      data.deviationsCount is number && data.deviationsCount >= 0 && data.deviationsCount <= 5 &&
      (!('deviationNotes' in data) || (data.deviationNotes is string && data.deviationNotes.size() <= 1000)) &&
      (!('operatorSignature' in data) || (data.operatorSignature is string && data.operatorSignature.size() <= 120)) &&
      (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isArchiveToggleAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly(['archived', 'updatedAt']) &&
        incoming().id == existing().id &&
        incoming().plantId == existing().plantId &&
        incoming().authorUid == existing().authorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
    }

    // 4. Collection: /checklists/{checklistId}
    match /checklists/{checklistId} {
      allow get: if isVerified() && isValidId(checklistId) && existing().plantId == 'biotrack-main';
      allow list: if isVerified() && existing().plantId == 'biotrack-main';

      allow create: if isVerified() &&
        isValidId(checklistId) &&
        isValidChecklist(incoming()) &&
        incoming().id == checklistId &&
        incoming().authorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerified() &&
        isValidId(checklistId) &&
        isValidChecklist(incoming()) &&
        (
          isAdmin() ||
          isArchiveToggleAction()
        );

      allow delete: if isVerified() &&
        isValidId(checklistId) &&
        (
          existing().authorUid == request.auth.uid ||
          isAdmin()
        );
    }
  }
}
